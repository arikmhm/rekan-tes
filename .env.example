# Salin file ini menjadi .env.local lalu isi dengan nilai pengembangan Anda.
# Jangan pernah menyimpan nilai sebenarnya di version control.
#
# Cara tercepat mengisi: `pnpx neon@latest env pull`

# Endpoint pooled (hostname memuat "-pooler"). Dipakai runtime aplikasi.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Endpoint direct tanpa pooling. Dipakai migrasi Drizzle Kit; endpoint pooled
# dapat menggagalkan DDL. Tidak dibutuhkan runtime aplikasi.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Secret penanda tangan session Better Auth. Buat nilai sendiri, jangan dibagikan:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"

# Base URL aplikasi. Tautan verifikasi email dan reset password dibangun dari
# nilai ini, jadi harus cocok dengan origin yang benar-benar dipakai.
BETTER_AUTH_URL="http://localhost:3000"

# API key Resend untuk email verifikasi dan reset password.
RESEND_API_KEY="re_ganti_dengan_key_anda"

# Alamat pengirim. Domain uji Resend dipakai bila dikosongkan; ganti ke domain
# sendiri yang sudah terverifikasi sebelum rilis.
# EMAIL_FROM="Rekan Tes <akun@rekan-tes.example.com>"

# DOKU SNAP QRIS (RT-009). Ambil dari DOKU Back Office. Tanpa variabel ini
# aplikasi tetap berjalan, tetapi pembuatan QRIS menolak dengan pesan yang
# menyebut variabel mana yang kurang.
# DOKU_CLIENT_ID="MCH-0000-00000000000000"
# DOKU_SECRET_KEY="SK-xxxxxxxxxxxxxxxx"

# Private key RSA merchant, dipakai menandatangani permintaan access token.
# Buat dengan: openssl genrsa -out private.key 2048
# Daftarkan public key-nya di DOKU Back Office, lalu tulis private key di sini
# sebagai satu baris dengan \n sebagai pengganti baris baru.
# DOKU_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# Mall ID dan terminal dari DOKU setelah registrasi QRIS disetujui, serta kode
# pos merchant yang wajib disertakan pada permintaan generate QRIS.
# DOKU_MERCHANT_ID="0000000000000"
# DOKU_TERMINAL_ID="TERM01"
# DOKU_POSTAL_CODE="10110"

# Basis API DOKU. Kosongkan untuk sandbox; isi https://api.doku.com saat rilis.
# DOKU_BASE_URL="https://api-sandbox.doku.com"
